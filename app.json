{
  "expo": {
    "name": "resqmesh_app",
    "slug": "resqmesh_app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow ResQMesh to use your location so emergency reports include the exact incident position."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ResQMesh to attach photos to emergency reports.",
          "cameraPermission": "Allow ResQMesh to take photos for emergency reports.",
          "microphonePermission": false
        }
      ],
      "react-native-maps"
    ]
  }
}
